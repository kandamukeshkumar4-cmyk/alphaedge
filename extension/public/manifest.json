{
  "manifest_version": 3,
  "name": "AlphaEdge Mirror",
  "version": "0.1.0",
  "description": "Research-only paper forecasting skill tracker for supported prediction-market pages.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://polymarket.com/*",
    "https://*.polymarket.com/*",
    "https://kalshi.com/*",
    "https://*.kalshi.com/*",
    "https://sportsbook.fanduel.com/*",
    "https://*.alphaedge.local/*",
    "http://localhost:8000/*",
    "https://*.azurestaticapps.net/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AlphaEdge Mirror",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*",
        "https://kalshi.com/*",
        "https://*.kalshi.com/*",
        "https://sportsbook.fanduel.com/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}

# AlphaEdge — paper-trading simulation only
PAPER_TRADING_ONLY=true

DATABASE_URL=postgresql+asyncpg://alphaedge:alphaedge@localhost:5432/alphaedge
DATABASE_URL_SYNC=postgresql://alphaedge:alphaedge@localhost:5432/alphaedge
REDIS_URL=redis://localhost:6379/0

ADMIN_API_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# System paper account
SYSTEM_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
SYSTEM_INITIAL_BANKROLL=100000.00

# Rate limiting
RATE_LIMIT=60/minute

# Week 4+ LLM (not required for Week 1)
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_JUDGE_MODEL=gemini-2.5-flash
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alphaedge

# Week 2+ external APIs (optional — fixtures used in CI)
ODDS_API_KEY=
POLYGON_RPC_URL=
POLYMARKET_SUBGRAPH_URL=
TRACKED_WALLET_ADDRESSES=

# Mirror MVP — adapter base URLs (server-side only; never sent to client)
POLYMARKET_GAMMA_BASE_URL=
KALSHI_API_BASE_URL=
KALSHI_API_KEY_ID=
KALSHI_SIGNING_PEM=

# Optional deploy helpers (do not commit real values)
KOYEB_TOKEN=
NEON_DATABASE_URL=
NEON_DATABASE_URL_SYNC=
NEXT_PUBLIC_API_URL=
